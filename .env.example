# CineMatrix configuration. Copy this file to .env and fill in your own settings.
# Groq is used only to plan the film and write shot prompts; generation is self-hosted.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# ComfyUI server hosting your open video model.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./workflows/video_api.json
# Required: positive text-prompt node and input name from your API-format workflow.
COMFYUI_PROMPT_NODE_ID=6
COMFYUI_PROMPT_INPUT=text
# Optional: negative prompt node/input.
COMFYUI_NEGATIVE_NODE_ID=
COMFYUI_NEGATIVE_INPUT=text
# Optional dynamic controls. Only set these if your workflow exposes matching numeric inputs.
# Frame count is computed as shot duration * storyboard FPS; your model may require a specific frame multiple.
COMFYUI_WIDTH_NODE_ID=
COMFYUI_WIDTH_INPUT=width
COMFYUI_HEIGHT_NODE_ID=
COMFYUI_HEIGHT_INPUT=height
COMFYUI_FRAMES_NODE_ID=
COMFYUI_FRAMES_INPUT=length
COMFYUI_FPS_NODE_ID=
COMFYUI_FPS_INPUT=frame_rate
COMFYUI_TIMEOUT_SECONDS=1800
# Mix a free locally synthesized background score under generated clip audio (true/false).
CINEMATRIX_SYNTHESIZE_SOUNDTRACK=true

# FFmpeg and ffprobe must be installed and available on PATH, or use absolute paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Keep local by default. Add comma-separated trusted origins only if you need a separate frontend.
CINEMATRIX_ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090
HOST=127.0.0.1
PORT=8090
